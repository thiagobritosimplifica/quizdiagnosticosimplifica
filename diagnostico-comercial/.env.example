# ---------------------------------------------------------------
# PAINEL ADMINISTRATIVO (obrigatório)
# ---------------------------------------------------------------
# Senha usada para entrar em /admin
ADMIN_PASSWORD=troque-esta-senha
# Chave usada para assinar o cookie de sessão (gere uma aleatória)
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------
# BANCO DE DADOS — GOOGLE SHEETS
# ---------------------------------------------------------------
# URL do Web App do Apps Script (google-sheets/Codigo.gs), termina em /exec.
# Sem esta variável, os leads são gravados em .data/leads.json (apenas dev).
SHEETS_WEBAPP_URL=
# O mesmo texto colocado em SEGREDO dentro do Apps Script.
# Gere um: node -e "console.log('simplifica_'+require('crypto').randomBytes(18).toString('base64url'))"
SHEETS_SECRET=

# ---------------------------------------------------------------
# MARCA E CHAMADA PARA AÇÃO
# ---------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=Simplifica
# Link do botão "QUERO MELHORAR MEU ATENDIMENTO"
NEXT_PUBLIC_CTA_URL=https://wa.me/5531973502678?text=Ol%C3%A1!%20Fiz%20o%20diagn%C3%B3stico%20e%20gostaria%20de%20saber%20mais.%20

# ---------------------------------------------------------------
# INTEGRAÇÕES (opcional) — Sheets, CRM, n8n/Make, WhatsApp, automação
# ---------------------------------------------------------------
# Aceita várias URLs separadas por vírgula.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
